{
  "id": "notes-lifecycle-v1",
  "description": "One bounded Notes Workspace lifecycle that every full showcase runs through its own adapter and compares on semantic outcome.",
  "normalization": [
    "Member names follow each flavor's idiom (ADR-0006). Adapters map them to the snapshot fields below; the values are compared exactly.",
    "A rejected operation is recorded as the error kind 'invalid'. The exception type and message are idiomatic per flavor and are not compared.",
    "Note ids and timestamps are generated per run and are never recorded.",
    "Only domain-visible events are recorded: 'theme:<previous>-><current>' for each ThemeChangedMessage and 'saved:<title>' for each note-form save. Property-change notifications are not recorded because their names are idiomatic; the recorded events are compared in order and are never reordered or deduplicated."
  ],
  "snapshot": {
    "notebook": "id of the notebook bound to the notes view",
    "notes": "note titles in the notes view's inner order",
    "selected": "title of the selected note, or null",
    "form": "null while the note form has no bound note, else {title, dirty, valid}",
    "theme": "name of the current theme preset",
    "events": "domain events the step produced, in order",
    "error": "null, or 'invalid' when the step's operation was rejected",
    "disposed": "whether the workspace has been disposed"
  },
  "steps": [
    {
      "action": "construct",
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot"],
        "selected": null,
        "form": null,
        "theme": "dark",
        "events": [],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "create_note",
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Untitled"],
        "selected": null,
        "form": null,
        "theme": "dark",
        "events": [],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "select_note",
      "index": 2,
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Untitled"],
        "selected": "Untitled",
        "form": {"title": "Untitled", "dirty": false, "valid": true},
        "theme": "dark",
        "events": [],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "edit_title",
      "title": "Groceries",
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Untitled"],
        "selected": "Untitled",
        "form": {"title": "Groceries", "dirty": true, "valid": true},
        "theme": "dark",
        "events": [],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "edit_title",
      "title": "  ",
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Untitled"],
        "selected": "Untitled",
        "form": {"title": "  ", "dirty": true, "valid": false},
        "theme": "dark",
        "events": [],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "edit_title",
      "title": "Groceries",
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Untitled"],
        "selected": "Untitled",
        "form": {"title": "Groceries", "dirty": true, "valid": true},
        "theme": "dark",
        "events": [],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "save",
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Groceries"],
        "selected": "Groceries",
        "form": {"title": "Groceries", "dirty": false, "valid": true},
        "theme": "dark",
        "events": ["saved:Groceries"],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "select_note",
      "index": 0,
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Groceries"],
        "selected": "Standup notes",
        "form": {"title": "Standup notes", "dirty": false, "valid": true},
        "theme": "dark",
        "events": [],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "delete_selected_declined",
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Groceries"],
        "selected": "Standup notes",
        "form": {"title": "Standup notes", "dirty": false, "valid": true},
        "theme": "dark",
        "events": [],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "set_theme",
      "theme": "light",
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Groceries"],
        "selected": "Standup notes",
        "form": {"title": "Standup notes", "dirty": false, "valid": true},
        "theme": "light",
        "events": ["theme:dark->light"],
        "error": null,
        "disposed": false
      }
    },
    {
      "action": "set_theme",
      "theme": "no-such-preset",
      "expect": {
        "notebook": "nb-work",
        "notes": ["Standup notes", "Roadmap snapshot", "Groceries"],
        "selected": "Standup notes",
        "form": {"title": "Standup notes", "dirty": false, "valid": true},
        "theme": "light",
        "events": [],
        "error": "invalid",
        "disposed": false
      }
    },
    {
      "action": "dispose",
      "expect": {
        "events": [],
        "error": null,
        "disposed": true
      }
    }
  ]
}
