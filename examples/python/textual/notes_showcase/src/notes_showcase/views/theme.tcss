/* Notes-Workspace Textual theme — palette per scenario §5.
 *
 * Palette:
 *   bg      #0E1320  (Screen background)
 *   pane    #141B2D  (panel surfaces)
 *   border  #2A3045  (separators / borders)
 *   accent  #4F8CD9  (focus / highlights)
 *   text    #E6EAF2  (foreground text)
 *   subtle  #7A86A1  (de-emphasised labels)
 */

Screen {
    background: #0E1320;
    color: #E6EAF2;
}

Header {
    background: #141B2D;
    color: #E6EAF2;
}

Footer {
    background: #141B2D;
    color: #E6EAF2;
}

#main_layout {
    height: 1fr;
}

/* Panes scroll vertically so every control stays reachable on small
 * terminals (80x24): the form alone is taller than the space left there. */
#notebooks_pane,
#notes_pane,
#form_pane {
    background: #141B2D;
    border: solid #2A3045;
    padding: 0 1;
    overflow-y: auto;
}

#notebooks_pane {
    width: 1fr;
    min-width: 18;
    max-width: 28;
}

#notebooks_tree {
    min-height: 4;
}

#notes_list {
    min-height: 4;
}

#form_body {
    min-height: 5;
}

#notes_pane {
    width: 1fr;
    min-width: 28;
}

#form_pane {
    width: 2fr;
}

.pane_title {
    color: #7A86A1;
    text-style: bold;
    padding: 0;
}

Tree {
    background: #141B2D;
    color: #E6EAF2;
}

Tree > .tree--cursor {
    background: #4F8CD9 30%;
}

ListView {
    background: #141B2D;
}

ListView > .list-view--cursor {
    background: #4F8CD9 30%;
}

ListItem {
    padding: 0 1;
    color: #E6EAF2;
}

Input:focus {
    border: solid #4F8CD9;
}

TextArea:focus {
    border: solid #4F8CD9;
}

#status_bar {
    height: 1;
    background: #141B2D;
    color: #7A86A1;
    padding: 0 1;
}

#capability_actions {
    height: 3;
    background: #141B2D;
    border-top: solid #2A3045;
    padding: 0 1;
}

#capability_actions Button {
    margin: 0;
    min-width: 6;
    width: auto;
}

#pagination_row {
    height: 3;
}

#pagination_row Button {
    min-width: 5;
    width: 5;
    margin: 0;
}

#page_label {
    width: 1fr;
    height: 3;
    content-align: center middle;
}

#notifications {
    dock: bottom;
    height: auto;
    background: transparent;
    padding: 0 1;
}

.notification {
    background: #2A3045;
    color: #E6EAF2;
    padding: 0 1;
    margin: 0 0 1 0;
    border: solid #4F8CD9;
}

#tag_chip_row,
#form_mode_row,
#form_buttons {
    height: auto;
}

#tag_chip_row Input {
    width: 1fr;
}

/* Size buttons to their labels so rows fit narrow panes. */
#tag_chip_row Button,
#tag_chips Button,
#form_mode_row Button,
#form_buttons Button,
#global_search_controls Button {
    width: auto;
    min-width: 6;
}

#tag_chips {
    height: auto;
}

/* Compact band: its natural height, not half the screen. */
#global_search {
    height: auto;
    background: #141B2D;
    border-top: solid #2A3045;
    padding: 0 1;
}

#global_search_controls {
    height: auto;
}

#global_search_input {
    width: 1fr;
}

#global_search_results {
    height: auto;
    max-height: 3;
}

.tag_chip {
    background: #2A3045;
    color: #E6EAF2;
    padding: 0 1;
    margin: 0 1 0 0;
}

Button {
    margin: 0 1;
}
