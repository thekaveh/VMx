<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The test runner remains on net9.0 while the product project remains on
      net8.0. A newer SDK can compile both targets, but executing the test host
      requires the .NET 9 runtime.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Coverlet line-coverage gate for the example's application logic.
      SeedData is data-only and excluded from the threshold count.
    -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <Threshold>90</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Include>[NotesShowcase]NotesShowcase.Models.*,[NotesShowcase]NotesShowcase.ViewModels.*,[NotesShowcase]NotesShowcase.Views.Adapter.*</Include>
    <!--
      SeedData is data-only (excluded from §3.a coverage scope).
      AvaloniaDispatcher and AvaloniaDialogService rely on a live Avalonia
      runtime (Dispatcher.UIThread, IStorageProvider, Window) and are exercised
      by the headless smoke tests rather than unit tests, so they are excluded
      from this gate.
    -->
    <ExcludeByFile>**/Models/SeedData.cs,**/Views/Adapter/AvaloniaDispatcher.cs,**/Views/Adapter/AvaloniaDialogService.cs</ExcludeByFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Reactive.Testing" Version="7.0.0" />
    <PackageReference Include="coverlet.msbuild" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Headless smoke-test driver; Avalonia 12 hosts through xunit v3. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NotesShowcase/NotesShowcase.csproj" />
    <ProjectReference Include="../../../../langs/csharp/src/VMx/VMx.csproj" />
    <ProjectReference Include="../../../../langs/csharp/src/VMx.Notifications/VMx.Notifications.csproj" />
  </ItemGroup>
</Project>
