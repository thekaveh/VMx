<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The showcase is an Avalonia desktop application:
        * OutputType = WinExe (cross-platform Avalonia bootstrap — the name is
          historical; works on macOS/Linux/Windows).
        * Avalonia.Desktop + Avalonia.Themes.Fluent for the runtime + base styles
          the dark theme overlays.
        * Avalonia.Fonts.Inter so .WithInterFont() resolves at startup.
        * AvaloniaUseCompiledBindingsByDefault is explicitly false: the showcase
          intentionally uses reflection-based bindings so the XAML paths against
          the VMs work without compiled-binding DataContext annotations on every
          control.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NotesShowcase</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Examples are not subject to the library's strict warning policy. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../langs/csharp/src/VMx/VMx.csproj" />
    <ProjectReference Include="../../../../langs/csharp/src/VMx.Notifications/VMx.Notifications.csproj" />
  </ItemGroup>
</Project>
