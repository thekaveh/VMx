{
  "name": "@thekaveh/vmx-react",
  "version": "0.1.0",
  "description": "Official React 18 and 19 bindings for VMx",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "check:deps": "npm ls --all --omit=optional",
    "lint": "eslint src tests",
    "test": "vitest run --coverage",
    "test:plain": "vitest run",
    "prepack": "npm run typecheck && npm run build"
  },
  "keywords": [
    "mvvm",
    "react",
    "rxjs",
    "viewmodel",
    "vmx"
  ],
  "author": "Kaveh Razavi",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://thekaveh.github.io/VMx/integration/react/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekaveh/VMx.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/thekaveh/VMx/issues"
  },
  "engines": {
    "node": ">=20.5.0"
  },
  "peerDependencies": {
    "@thekaveh/vmx": "^3.24.0",
    "react": "^18.3.1 || ^19.0.0",
    "rxjs": "^7.8.0",
    "use-sync-external-store": "^1.6.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.1",
    "@thekaveh/vmx": "file:../../langs/typescript",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.0 || ^19.0.0",
    "@types/react-dom": "^18.3.0 || ^19.0.0",
    "@types/use-sync-external-store": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.8",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "rxjs": "^7.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "use-sync-external-store": "^1.6.0",
    "vitest": "^4.1.8"
  }
}
