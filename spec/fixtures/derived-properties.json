{
  "$schema-version": "1.0.0",
  "transforms": {
    "sum": "(*xs) -> sum(xs)",
    "concat": "(*xs) -> ''.join(str(x) for x in xs)"
  },
  "scenarios": [
    {
      "name": "single-source-initial-value",
      "sources_initial": [10],
      "transform": "sum",
      "mutations": [],
      "expected_values": [10],
      "expected_emissions": []
    },
    {
      "name": "single-source-one-mutation",
      "sources_initial": [10],
      "transform": "sum",
      "mutations": [[0, 20]],
      "expected_values": [10, 20],
      "expected_emissions": [20]
    },
    {
      "name": "two-sources-additive",
      "sources_initial": [1, 2],
      "transform": "sum",
      "mutations": [[0, 5], [1, 7]],
      "expected_values": [3, 7, 12],
      "expected_emissions": [7, 12]
    },
    {
      "name": "five-sources-additive",
      "sources_initial": [1, 2, 3, 4, 5],
      "transform": "sum",
      "mutations": [[2, 30]],
      "expected_values": [15, 42],
      "expected_emissions": [42]
    },
    {
      "name": "distinct-until-changed",
      "sources_initial": [5, 5],
      "transform": "sum",
      "mutations": [[0, 3], [1, 7], [0, 3]],
      "expected_values": [10, 8, 10, 10],
      "expected_emissions": [8, 10]
    },
    {
      "name": "concat-string-sources",
      "sources_initial": ["a", "b"],
      "transform": "concat",
      "mutations": [[1, "c"]],
      "expected_values": ["ab", "ac"],
      "expected_emissions": ["ac"]
    }
  ]
}
